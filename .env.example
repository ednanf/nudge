# Local SQLite; replace with libsql://... and a token on Vercel.
DATABASE_URL=file:./nudge.db
DATABASE_AUTH_TOKEN=
# Generate with npm run admin:hash
ADMIN_PASSWORD_HASH=
# Exactly 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32 (at least 32 characters)
CRON_SECRET=
# Exact browser origin; use your production domain on Vercel.
APP_ORIGIN=http://localhost:5173
